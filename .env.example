# Required — the prospect's brain and the grader.
ANTHROPIC_API_KEY=

# Optional — realistic studio voices for the prospect (falls back to browser speech).
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# Per-character voice overrides: ELEVENLABS_VOICE_<SCENARIO>_<GK|DM>, e.g.
# ELEVENLABS_VOICE_MERIDIAN_DM=XrExE9yKIg1WjnnlVkGX
# ELEVENLABS_VOICE_REP=pNInz6obpgDQGcFmaJgB

# Optional — require this password (any username) before anyone can use the app.
# With it set the server listens on all interfaces; without it, only on this machine.
# APP_PASSWORD=
# HOST=127.0.0.1

# Optional tuning.
# PORT=3000
# PROSPECT_MODEL=claude-opus-5
# PROSPECT_EFFORT=low
# GRADER_MODEL=claude-opus-5
# DATA_FILE=./data/calls.json
# LOG_LATENCY=1

# Live voice (ElevenLabs Agents on the line; see README "Live voice")
# PUBLIC_URL=https://your-host.example        # where ElevenLabs can reach this server (Vercel sets this itself)
# BLOB_READ_WRITE_TOKEN=                        # Vercel only: a connected Blob store for shared call state
# ELEVENLABS_AGENT_TTS_MODEL=eleven_turbo_v2    # or eleven_flash_v2 (English agents take one of these two)
# VOICE_STACK=off                               # force the browser-recognition fallback
